{
  "name": "amin-lab-genie",
  "version": "1.5.2",
  "private": true,
  "description": "Amin-Lab -Pro🔬 — نظام إدارة مختبر العلوم (جرد، إعارة، جدول زمني، QC، تقارير)",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server/src/index.ts",
    "dev": "node --watch server/src/index.ts",
    "build": "tsc -p server/tsconfig.json",
    "serve:dist": "node server/dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "backup": "node --input-type=module -e \"import('./server/src/utils/backup.ts').then(m => console.log(m.createBackup()))\"",
    "icons": "node scripts/make-icons.mjs",
    "license": "node scripts/make-license.mjs",
    "package": "node scripts/create-package.mjs",
    "set-password": "node scripts/set-password.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
