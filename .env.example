# انسخ هذا الملف إلى .env ثم عدّل القيم (لا تُودِع .env في Git).

# سرّ توقيع الجلسات ومفتاح الترخيص المشتق. إلزامي في الإنتاج.
# ولّده بـ: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# تنبيه: بدون ضبطه لا تُقبل المفاتيح المشتقة (تبقى مفاتيح التوليد من الإعدادات صالحة).
APP_SECRET=

# المنفذ والعنوان
PORT=3000
HOST=0.0.0.0

# مسارات البيانات والنسخ الاحتياطي
DATA_DIR=data
# DB_PATH=data/amin-lab-genie.sqlite
# BACKUP_DIR=data/backups
# BACKUP_RETENTION=14

# مدة الجلسة بالثواني (8 ساعات افتراضياً)
# SESSION_TTL=28800

# مدة الفترة التجريبية بالأيام (30 افتراضياً)
# TRIAL_DAYS=30
